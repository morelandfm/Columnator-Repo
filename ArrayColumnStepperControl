//Constants for the column orientation stepper
const int MS1 = 13;
const int MS2 = 12;
const int direction = 11;
const int clk = 10;
const int on_off = 9;

const int stp_size_chg = 8;
const int dir_chg = 7;
const int move = 6;

int stepDelay = 2000;

//Constants for the array stepper
constexpr int FPUSH = 1000; //The final push to make sure that the track is clear, should be long enough to go over the edge of the delrin
constexpr int CPUSH = 800; //The number of steps to push a single column of 
constexpr int RPUSH = 960; //The number of steps to push a rail if needed or desired
constexpr int RESET = 9960; // 10000 //The number of steps required to reset the position (3.125")
constexpr int STARTPOS = 40; //The number of steps that will take the stepper from the reset position to the position where the array will just meet the edge of the delrin

constexpr int PUL = 1; //GPIO port for stepper pulse
constexpr int DIR = 2; //GPIO port for stepper direction
constexpr int ENA = 3; //GPIO port for enable on the stepper motor driver
//constexpr int LACT = 8; //GPIO port for linear actuator, not currently using the linear motors anymore
//constexpr int START_BT = 5; //GPIO port for button 
constexpr int BACK_BT = 4; //GPIO port for a button to move the stepper back
constexpr int FOWARD_BT = 5; //GPIO port for a button to move the stepper foward


//Functions for the array stepper motor
//Determine the amount of steps required to push a single column
void push(int duration){
  digitalWrite(DIR, LOW);
  delay(10);
  //1000 is a place holder, the count should remain the same throughout and so would then be the most accurate way to duplicate the distance at which the pusher is pushing a column
  //If the counter is below the desired count, continues to push through pulse
  for (int i = 0; i < duration; i++){
    //Pulsing for moving the stepper, speed is increased as delay is decreased
    digitalWrite(PUL, HIGH);
    delay(1);
    digitalWrite(PUL, LOW);
    delay(1);
  }
  //digitalWrite(DIR, HIGH);
}

void manualReset(bool direction, int btn) {
  digitalWrite(DIR, direction);
  delay(10);
  while (!digitalRead(btn))
    reset(10, true);
}

//This function is the reset position for the columnating function
void reset(int duration, bool direction){
  for (int i = 0; i < duration; i++){
    digitalWrite(PUL, HIGH);
    delay(1);
    digitalWrite(PUL, LOW);
    delay(1);    
  }
  //digitalWrite(dir, LOW);
}

