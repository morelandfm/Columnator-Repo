//Function for automatically columnating each column on an array
void columnate(){
  //Go to the start position
  Serial.println("inital push rail break");
  digitalWrite(DIR, LOW);
  //push(STARTPOS);
  delay(200);
  push(RPUSH);
  delay(600);
  //actuate();
  delay(600);
  //This array has 10 columns
  //Set to one when testing the distance it pushes
  //for (int i = 0; i < 10; i++){
  for (int i = 0; i < 10; i++){
    if (!digitalRead(BACK_BT) || !digitalRead(FOWARD_BT))
      return;

    Serial.print("columnate #");
    Serial.println(i);
    //digitalWrite(DIR, LOW);
    //Calls the single column push function
    push(CPUSH);
    //This delay is there in order to give the stepper enough time to push the column before it actuates it, should be equal to or longer than the push function
    delay(1000);
    //Extend linear actuator
    //actuate();
    //Delay in the program for the linear actuator to actually break the column
    delay(1000);
  }
  delay(1000);
  push(FPUSH);
  Serial.println("columnate reset");
  digitalWrite(DIR, true);
  delay(10);
  reset(RESET, true);
  //Finish is the function that will push out the last column and clear the track, going a little bit beyond the end of the delrin
}

//Functions for the column orientation stepper

void dirChange(int currentState){
  if(currentState == 1){
    digitalWrite(direction, LOW);
  }
  else{
    digitalWrite(direction, HIGH);
  }
  Serial.print("Direction changed");
  delay(300);
}

/*
This function fractions the step size based on current assumptions that keeping
MS1 and MS2 low will do a full step, MS1 low and MS2 high will do a half step,
MS1 high and MS2 low will do a quarter step, and both MS1 and MS2 high will do an eigth step

So then the inputs need to be digitalRead(MS1), digitalRead(MS2)
*/
void stepChange(int msone, int mstwo){
  if(msone == 0 && mstwo == 0){
    digitalWrite(MS1, LOW);
    digitalWrite(MS2, HIGH);
  }
  else if(msone == 0 && mstwo == 1){
    digitalWrite(MS1, HIGH);
    digitalWrite(MS2, LOW);
  }
  else if(msone == 1 && mstwo == 0){
    digitalWrite(MS1, HIGH);
    digitalWrite(MS2, HIGH);
  }
  else if(msone == 1 && mstwo == 1){
    digitalWrite(MS1, LOW);
    digitalWrite(MS2, LOW);
  }
  Serial.print("Step size changed");
  delay(300);
}

/*
This is the function for actually moving the stepper, and really
should just take nothing, and be called when the moving button is pressed
*/
void moving(void){
  digitalWrite(clk, HIGH);
  delayMicroseconds(10);
  digitalWrite(clk, LOW);
  delayMicroseconds(stepDelay);

}

//Setting up all of the GPIO for the pico
void setup() 
{
  //Setup for the array stepper
  Serial.begin(115200);
  //pinMode(START_BT, INPUT_PULLUP);
  pinMode(PUL, OUTPUT);
  pinMode(DIR, OUTPUT);
  //pinMode(LACT, OUTPUT);
  pinMode(BACK_BT, INPUT_PULLUP);
  pinMode(FOWARD_BT, INPUT_PULLUP);
  
  //digitalWrite(LACT, LOW);

  //Setup for the column stepper
  pinMode(stp_size_chg, INPUT_PULLUP);
  pinMode(dir_chg, INPUT_PULLUP);
  pinMode(move, INPUT_PULLUP);
  pinMode(direction, OUTPUT);
  pinMode(clk, OUTPUT);
  pinMode(MS1, OUTPUT);
  pinMode(MS2, OUTPUT);
  pinMode(on_off, OUTPUT);
  digitalWrite(MS1, LOW);
  digitalWrite(MS2, LOW);
  digitalWrite(direction, LOW);
  digitalWrite(on_off, HIGH);
  digitalWrite(clk, LOW);
  //Currently uneccesary
  //Serial.print("Set up complete");
}

//For now the button is the only thing getting the system to run so that's all that's in the loop
void loop() 

{
  //Array stepper loop
  /*
  if (digitalRead(START_BT) == 0){
    Serial.println("columnate start");
    columnate();
  }*/

  //Here for when needed
  if (digitalRead(BACK_BT) == 0){
    manualReset(true, BACK_BT);
  }

  if (digitalRead(FOWARD_BT) == 0){
    manualReset(false, FOWARD_BT);
  }

  //Column stepper loop
    int dirState = digitalRead(dir_chg);
  int stepState = digitalRead(stp_size_chg);
  int moveState = digitalRead(move);
  if(dirState == 0){
    dirChange(digitalRead(direction));
  }
  if(stepState == 0){
    stepChange(digitalRead(MS1), digitalRead(MS2));
  }
  while(digitalRead(move) == 0){
    moving();
  }

}
