//Function for automatically columnating each column on an array
void columnate(){
  //Go to the start position
  Serial.println("inital push rail break");
  digitalWrite(DIR, LOW);
  //push(STARTPOS);
  delay(200);
  push(RPUSH);
  delay(600);
  //actuate();
  delay(600);
  //This array has 10 columns
  //Set to one when testing the distance it pushes
  //for (int i = 0; i < 10; i++){
  for (int i = 0; i < 10; i++){
    if (!digitalRead(BACK_BT) || !digitalRead(FOWARD_BT))
      return;

    Serial.print("columnate #");
    Serial.println(i);
    //digitalWrite(DIR, LOW);
    //Calls the single column push function
    push(CPUSH);
    //This delay is there in order to give the stepper enough time to push the column before it actuates it, should be equal to or longer than the push function
    delay(1000);
    //Extend linear actuator
    //actuate();
    //Delay in the program for the linear actuator to actually break the column
    delay(1000);
  }
  delay(1000);
  push(FPUSH);
  Serial.println("columnate reset");
  digitalWrite(DIR, true);
  delay(10);
  reset(RESET, true);
  //Finish is the function that will push out the last column and clear the track, going a little bit beyond the end of the delrin
}

//Setting up all of the GPIO for the pico
void setup() 
{
  Serial.begin(115200);
  pinMode(START_BT, INPUT_PULLUP);
  pinMode(PUL, OUTPUT);
  pinMode(DIR, OUTPUT);
  //pinMode(LACT, OUTPUT);
  pinMode(BACK_BT, INPUT_PULLUP);
  pinMode(FOWARD_BT, INPUT_PULLUP);
  
  //digitalWrite(LACT, LOW);
}

//For now the button is the only thing getting the system to run so that's all that's in the loop
void loop() 
{
  if (digitalRead(START_BT) == 0){
    Serial.println("columnate start");
    columnate();
  }

  //Here for when needed
  if (digitalRead(BACK_BT) == 0){
    manualReset(true, BACK_BT);
  }

  if (digitalRead(FOWARD_BT) == 0){
    manualReset(false, FOWARD_BT);
  }
}
